   "source": [
    "from bs4 import BeautifulSoup\n",
    "import os\n",
    "import re\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def clean_text(text):\n",
    "    if text:\n",
    "        # تنظيف الفواصل والمساحات الزائدة\n",
    "        text = text.replace(\"\\xa0\", \" \").strip()\n",
    "        return re.sub(r\"\\s+\", \" \", text)\n",
    "    return \"\"\n",
    "\n",
    "\n",
    "def process_html_file(file_path):\n",
    "    # قراءة الملف بالترميز المناسب للغة العربية windows-1256\n",
    "    with open(file_path, \"r\", encoding=\"windows-1256\", errors=\"ignore\") as f:\n",
    "        content = f.read()\n",
    "\n",
    "    soup = BeautifulSoup(content, \"html.parser\")\n",
    "    tables = soup.find_all(\"table\")\n",
    "\n",
    "    branch_name = \"\"\n",
    "    supplier_name = \"\"\n",
    "    file_name = os.path.basename(file_path)  # اسم الملف المصدر\n",
    "\n",
    "    # استخراج اسم الفرع والمورد من جداول الهيدر\n",
    "    for table in tables[:3]:\n",
    "        text = clean_text(table.get_text())\n",
    "        if \"قطونيل\" in text:\n",
    "            branch_name = text\n",
    "        if \"للمورد\" in text:\n",
    "            match = re.search(r\"للمورد\\s+([^\\s]+)\", text)\n",
    "            if match:\n",
    "                supplier_name = match.group(1)\n",
    "\n",
    "    rows_data = []\n",
    "\n",
    "    # معالجة جداول البيانات\n",
    "    for table in tables:\n",
    "        tds = table.find_all(\"td\")\n",
    "        # صفوف المنتجات تحتوي على 11 أو 12 خلية (الخلية الأولى فارغة أحياناً)\n",
    "        if len(tds) in [11, 12]:\n",
    "            values = [clean_text(td.get_text()) for td in tds]\n",
    "\n",
    "            # تجاهل صفوف العناوين والإجماليات\n",
    "            first_val = values[0] if values[0] != \"\" else values[1]\n",
    "            if any(\n",
    "                keyword in first_val\n",
    "                for keyword in [\"الصنف\", \"الإجمالى\", \"طباعة\", \"المستهلك\"]\n",
    "            ):\n",
    "                continue\n",
    "\n",
    "            # إذا كانت الخلية الأولى فارغة (مساحة جانبية)، نقوم بإزالتها لمحاذاة الأعمدة\n",
    "            if values[0] == \"\":\n",
    "                values = values[1:]\n",
    "\n",
    "            # التأكد من أن الصف يحتوي على 11 عمود متناسق\n",
    "            if len(values) == 11:\n",
    "                row_dict = {\n",
    "                    \"Source_File\": file_name,\n",
    "                    \"Branch\": branch_name,\n",
    "                    \"Supplier\": supplier_name,\n",
    "                    \"Item_Name\": values[0],\n",
    "                    \"Retail_Price\": values[1],\n",
    "                    \"Item_Code\": values[2],\n",
    "                    \"Purchase\": values[3],\n",
    "                    \"Purchase_Returns\": values[4],\n",
    "                    \"Sales\": values[5],\n",
    "                    \"Sales_Returns\": values[6],\n",
    "                    \"Net_Product_Sales_QTY\": values[7],\n",
    "                    \"Net_Product_Sales_Value\": values[8],\n",
    "                    \"Balance_QTY\": values[9],\n",
    "                    \"Balance_Value\": values[10],\n",
    "                }\n",
    "                rows_data.append(row_dict)\n",
    "\n",
    "    return rows_data\n",
    "\n",
    "\n",
    "def process_all_files(input_dir, output_file):\n",
    "    all_records = []\n",
    "\n",
    "    # التأكد من وجود مجلد الحفظ\n",
    "    output_dir = os.path.dirname(output_file)\n",
    "    if not os.path.exists(output_dir):\n",
    "        os.makedirs(output_dir)\n",
    "\n",
    "    # المرور على كل ملفات HTML في المجلد\n",
    "    for file_name in os.listdir(input_dir):\n",
    "        if file_name.endswith(\".html\") or file_name.endswith(\".htm\"):\n",
    "            file_path = os.path.join(input_dir, file_name)\n",
    "            file_records = process_html_file(file_path)\n",
    "            all_records.extend(file_records)\n",
    "\n",
    "    # تحويل البيانات إلى DataFrame وحفظها كـ CSV\n",
    "    df = pd.DataFrame(all_records)\n",
    "\n",
    "    # تحويل الأعمدة الرقمية لضمان سلامة البيانات\n",
    "    numeric_cols = [\n",
    "        \"Retail_Price\",\n",
    "        \"Purchase\",\n",
    "        \"Purchase_Returns\",\n",
    "        \"Sales\",\n",
    "        \"Sales_Returns\",\n",
    "        \"Net_Product_Sales_QTY\",\n",
    "        \"Net_Product_Sales_Value\",\n",
    "        \"Balance_QTY\",\n",
    "        \"Balance_Value\",\n",
    "    ]\n",
    "    for col in numeric_cols:\n",
    "        if col in df.columns:\n",
    "            df[col] = pd.to_numeric(df[col], errors=\"coerce\").fillna(0)\n",
    "\n",
    "    # حفظ الملف بترميز utf-8-sig لدعم اللغة العربية في Excel\n",
    "    df.to_csv(output_file, index=False, encoding=\"utf-8-sig\")\n",
    "    print(f\"تمت المعالجة بنجاح! تم حفظ {len(df)} سجل في:\\n{output_file}\")\n",
    "\n",
    "\n",
    "# تحديد المسارات\n",
    "source_directory = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\Html Cottonil Files\\حركه الاصناف\\all\"\n",
    "destination_file = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\prepared data\\product movement\\product_movement_clean.csv\"\n",
    "\n",
    "# تشغيل السكربت\n",
    "process_all_files(source_directory, destination_file)"
   ]
  },
