   "source": [
    "import os\n",
    "import re\n",
    "from bs4 import BeautifulSoup\n",
    "import pandas as pd\n",
    "\n",

    "folder_path = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\Html Cottonil Files\\المبيعات\"\n",
    "clean_data_path = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\prepared data\\Sales\"\n",
    "\n",
    "os.makedirs(clean_data_path, exist_ok=True)\n",
    "\n",
    "\n",

    "def natural_sort_key(s):\n",
    "    return [\n",
    "        int(text) if text.isdigit() else text.lower()\n",
    "        for text in re.split(r\"(\\d+)\", s)\n",
    "    ]\n",
    "\n",
    "\n",
,
    "all_rows = []\n",
    "\n",
    "raw_files = [\n",
    "    f for f in os.listdir(folder_path) if f.lower().endswith((\".html\", \".htm\"))\n",
    "]\n",
    "files = sorted(raw_files, key=natural_sort_key)\n",
    "\n",
    "print(f\"Found {len(files)} HTML files\")\n",
    "\n",
    "for file in files:\n",
    "    file_path = os.path.join(folder_path, file)\n",
    "\n",
    "    try:\n",
    "\n",
    "        # قراءة الملف بترميز windows-1256 المعتمد في ملفاتك\n",
    "        with open(file_path, \"r\", encoding=\"windows-1256\", errors=\"ignore\") as f:\n",
    "            # استخدام lxml كمحلل لضمان عدم تكرار قراءة أجزاء الجدول\n",
    "            soup = BeautifulSoup(f.read(), \"lxml\")\n",
    "\n",
    "        # استخراج جميع الصفوف داخل الجدول\n",
    "        rows = soup.find_all(\"tr\")\n",
    "\n",
    "        for row in rows:\n",
    "            cols = row.find_all(\"td\")\n",
    "            # تنظيف النصوص داخل الخلايا\n",
    "            cols_text = [c.get_text(strip=True) for c in cols]\n",
    "\n",
    "            # التأكد من أن الصف يحتوي على 9 أعمدة (صف بيانات الفاتورة)\n",
    "            # والتحقق من أن العمود الثاني يحتوي على تاريخ\n",
    "            if len(cols_text) == 9 and \"/\" in cols_text[1]:\n",
    "                data_row = {\n",
    "                    \"Source_File\": file,\n",
    "                    \"Date\": cols_text[1],\n",
    "                    \"Invoice_No\": cols_text[2],\n",
    "                    \"Item_Code\": cols_text[3],\n",
    "                    \"Barcode\": (\n",
    "                        cols_text[4] if cols_text[4] != \"\" else None\n",
    "                    ),  # استخراج الباركود بدقة\n",
    "                    \"Item_Name\": cols_text[5],\n",
    "                    \"Price\": cols_text[6],\n",
    "                    \"Quantity\": cols_text[7],\n",
    "                    \"Total_Value\": cols_text[8],\n",
    "                }\n",
    "                all_rows.append(data_row)\n",
    "\n",
    "        print(f\"✔ Successfully Processed: {file}\")\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error processing {file}: {e}\")\n",
    "\n",
    "# ============================\n",
    "# Save to CSV\n",
    "# ============================\n",
    "if all_rows:\n",
    "    final_df = pd.DataFrame(all_rows)\n",
    "\n",
    "    # إزالة الصفوف المكررة تماماً إن وجدت أثناء الاستخراج\n",
    "    final_df = final_df.drop_duplicates()\n",
    "\n",
    "    # تحويل أنواع البيانات للتنظيف\n",
    "    final_df[\"Price\"] = pd.to_numeric(final_df[\"Price\"], errors=\"coerce\")\n",
    "    final_df[\"Quantity\"] = pd.to_numeric(final_df[\"Quantity\"], errors=\"coerce\")\n",
    "    final_df[\"Total_Value\"] = pd.to_numeric(\n",
    "        final_df[\"Total_Value\"], errors=\"coerce\"\n",
    "    )\n",
    "\n",
    "    # حفظ الملف\n",
    "    output_file = os.path.join(clean_data_path, \"Sales_All.csv\")\n",
    "    final_df.to_csv(output_file, index=False, encoding=\"utf-8-sig\")\n",
    "\n",
    "    print(\"=\" * 50)\n",
    "    print(\"Finished Successfully!\")\n",
    "    print(f\"Total Rows Extracted: {len(final_df)}\")\n",
    "    print(f\"Saved to: {output_file}\")\n",
    "else:\n",
    "    print(\"No valid sales data found.\")"
   ]
