    "import glob\n",
    "import os\n",
    "import re\n",
    "import pandas as pd\n",
    "from bs4 import BeautifulSoup\n",
    "\n",
    "INPUT_FOLDER = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\Html Cottonil Files\\جرد البضاعة\"\n",
    "OUTPUT_FILE = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\prepared data\\Products\\Combined_Inventory.csv\"\n",
    "\n",
    "os.makedirs(os.path.dirname(OUTPUT_FILE), exist_ok=True)\n",
    "\n",
    "rows_data = []\n",
    "files = sorted(glob.glob(os.path.join(INPUT_FOLDER, \"*.html\")))\n",
    "\n",
    "# قائمة المقاسات الشهيرة للتحقق الذكي\n",
    "SIZE_PATTERNS = r\"^(s|m|l|xl|xxl|3xl|4xl|5xl|\\d+-\\d+|\\d+|\\-\\-)$\"\n",
    "\n",
    "\n",
    "def is_size_value(text):\n",
    "    text_clean = text.strip().lower()\n",
    "    return bool(re.match(SIZE_PATTERNS, text_clean))\n",
    "\n",
    "\n",
    "for file_path in files:\n",
    "    file_name = os.path.basename(file_path)\n",
    "\n",
    "    with open(file_path, \"rb\") as f:\n",
    "        soup = BeautifulSoup(f, \"html.parser\")\n",
    "\n",
    "    current_level = \"\"\n",
    "    tables = soup.find_all(\"table\")\n",
    "\n",
    "    for table in tables:\n",
    "        # استخراج مستوى القسم\n",
    "        level_td = table.find(\n",
    "            \"td\", string=lambda t: t and \"طباعة الجرد على مستوى\" in t\n",
    "        )\n",
    "        if level_td:\n",
    "            next_tds = table.find_all(\"td\")\n",
    "            if len(next_tds) >= 4:\n",
    "                current_level = next_tds[-1].get_text(strip=True)\n",
    "            continue\n",
    "\n",
    "        tds = table.find_all(\"td\")\n",
    "        if not tds:\n",
    "            continue\n",
    "\n",
    "        raw_tds = [td.get_text(strip=True) for td in tds]\n",
    "        combined_text = \"\".join(raw_tds)\n",
    "\n",
    "        # استبعاد الهيدر والفوتر والجداول غير المجدية\n",
    "        if (\n",
    "            not combined_text\n",
    "            or \"الصنف\" in combined_text\n",
    "            or \"إجمالى\" in combined_text\n",
    "            or \"طباعة بتاريخ\" in combined_text\n",
    "            or \"قطونيل شيراتون\" in combined_text\n",
    "        ):\n",
    "            continue\n",
    "\n",
    "        if len(tds) >= 7:\n",
    "            first_val = tds[1].get_text(strip=True) if len(tds) > 1 else \"\"\n",
    "\n",
    "            # فحص هل الخلية الأولى صنف أم مقاس مرحّل؟\n",
    "            if first_val and is_size_value(first_val):\n",
    "                # إذا كانت الخلية الأولى مقاس (زي 13-14 أو xl)\n",
    "                item_name = None  # نتركها None ليعمل عليها Fill Down لاحقاً\n",
    "                size = first_val\n",
    "                color = tds[2].get_text(strip=True) if len(tds) > 2 else \"\"\n",
    "                group = tds[3].get_text(strip=True) if len(tds) > 3 else \"\"\n",
    "            else:\n",
    "                # إذا كانت صنف حقيقي\n",
    "                item_name = first_val if first_val else None\n",
    "                size = tds[2].get_text(strip=True) if len(tds) > 2 else \"\"\n",
    "                color = tds[3].get_text(strip=True) if len(tds) > 3 else \"\"\n",
    "                group = tds[4].get_text(strip=True) if len(tds) > 4 else \"\"\n",
    "\n",
    "            # الرصيد دائماً في آخر خلية\n",
    "            balance = tds[-1].get_text(strip=True)\n",
    "\n",
    "            # استخراج الباركود بأمان (أرقام فقط)\n",
    "            barcode = \"\"\n",
    "            for td in tds[4:-1]:\n",
    "                txt = td.get_text(strip=True)\n",
    "                if txt.isdigit():\n",
    "                    barcode = txt\n",
    "                    break\n",
    "\n",
    "            if not barcode and len(tds) > 8:\n",
    "                barcode = tds[8].get_text(strip=True)\n",
    "\n",
    "            rows_data.append(\n",
    "                {\n",
    "                    \"Source\": file_name,\n",
    "                    \"Section\": current_level,\n",
    "                    \"Item\": item_name,\n",
    "                    \"Size\": size,\n",
    "                    \"Colour\": color,\n",
    "                    \"Group\": group,\n",
    "                    \"Code\": str(barcode).strip(),\n",
    "                    \"Balance\": balance,\n",
    "                }\n",
    "            )\n",
    "\n",
    "# ---------------------------------------------\n",
    "# إنشاء DataFrame وتطبيق Fill Down\n",
    "# ---------------------------------------------\n",
    "df = pd.DataFrame(rows_data)\n",
    "\n",
    "if not df.empty:\n",
    "    # 1. تنظيف القيم الفارغة و الـ \"--\"\n",
    "    df.replace({\"--\": \"\", \"\": None}, inplace=True)\n",
    "\n",
    "    # 2. تطبيق Fill Down على اسم الصنف والقسم\n",
    "    df[\"Item\"] = df[\"Item\"].ffill()\n",
    "    df[\"Section\"] = df[\"Section\"].ffill()\n",
    "\n",
    "    # 3. استبدال None المتبقية بنصوص فارغة\n",
    "    df.fillna(\"\", inplace=True)\n",
    "\n",
    "    # 4. تنظيف المسافات الزائدة\n",
    "    for col in df.columns:\n",
    "        df[col] = df[col].astype(str).str.strip()\n",
    "\n",
    "    df.reset_index(drop=True, inplace=True)\n",
    "    df.to_csv(OUTPUT_FILE, index=False, encoding=\"utf-8-sig\")\n",
    "\n",
    "    print(\n",
    "        f\"تم إعادة هيكلة البيانات بنجاح! إجمالي الأسطر: {len(df)}\\n\"\n",
    "    )\n",
    "\n",
    "    # عرض أول 20 سطر لمعاينة النتيجة بالضبط كما في Power Query\n",
    "    print(df.head(20).to_string())\n",
    "else:\n",
    "    print(\"لم يتم العثور على بيانات.\")"
   ]
  },
