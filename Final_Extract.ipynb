   "source": [
    "import os\n",
    "import re\n",
    "from bs4 import BeautifulSoup\n",
    "import pandas as pd\n",
    "\n",
    "def extract_page_number(filename):\n",
    "    \"\"\"استخراج رقم الصفحة الحقيقي المتواجد بعد كلمة Page أو من نهاية الاسم\"\"\"\n",
    "    match = re.search(r'Page(\\d+)', filename, re.IGNORECASE)\n",
    "    if match:\n",
    "        return int(match.group(1))\n",
    "    \n",
    "    numbers = re.findall(r'\\d+', filename)\n",
    "    return int(numbers[-1]) if numbers else 0\n",
    "\n",
    "def process_cottonil_sales_directory(input_folder, output_folder, csv_filename=\"all_sales_data.csv\", report_filename=\"validation_report.txt\"):\n",
    "    os.makedirs(output_folder, exist_ok=True)\n",
    "    \n",
    "    csv_output_path = os.path.join(output_folder, csv_filename)\n",
    "    report_output_path = os.path.join(output_folder, report_filename)\n",
    "\n",
    "    lines_to_output = []\n",
    "    \n",
    "    def log(text=\"\"):\n",
    "        print(text)\n",
    "        lines_to_output.append(text)\n",
    "\n",
    "    def safe_float(val):\n",
    "        if not val:\n",
    "            return 0.0\n",
    "        try:\n",
    "            cleaned = str(val).replace(\",\", \"\").strip()\n",
    "            return float(cleaned)\n",
    "        except ValueError:\n",
    "            return 0.0\n",
    "\n",
    "    log(\"=\" * 60)\n",
    "    log(\"🔍 بدء عملية المعالجة والدقة العالية لملفات قطونيل HTML...\")\n",
    "    log(\"=\" * 60 + \"\\n\")\n",
    "\n",
    "    if not os.path.exists(input_folder):\n",
    "        log(f\"❌ المسار غير موجود: {input_folder}\")\n",
    "        return\n",
    "\n",
    "    files = [f for f in os.listdir(input_folder) if f.endswith('.html') or f.endswith('.htm')]\n",
    "    files = sorted(files, key=extract_page_number)\n",
    "    \n",
    "    if not files:\n",
    "        log(\"❌ لم يتم العثور على أي ملفات HTML في المسار المحدد!\")\n",
    "        return\n",
    "\n",
    "    all_extracted_rows = []\n",
    "    total_summary_pages = 0\n",
    "\n",
    "    for file_name in files:\n",
    "        file_path = os.path.join(input_folder, file_name)\n",
    "        \n",
    "        with open(file_path, 'r', encoding='windows-1256', errors='ignore') as f:\n",
    "            soup = BeautifulSoup(f.read(), 'html.parser')\n",
    "\n",
    "        page_text = soup.get_text()\n",
    "        all_trs = soup.find_all('tr')\n",
    "        \n",
    "        has_permit_rows = False\n",
    "        for row in all_trs:\n",
    "            cols = [td.get_text(strip=True) for td in row.find_all(['td', 'th'])]\n",
    "            if cols and cols[0].replace(\",\", \"\").strip().isdigit():\n",
    "                has_permit_rows = True\n",
    "                break\n",
    "\n",
    "        if \"التقرير النهائي\" in page_text and not has_permit_rows:\n",
    "            log(f\"📄 [صفحة تجميعات نهائية]: {file_name} -> (تم التخطي بنجاح)\")\n",
    "            total_summary_pages += 1\n",
    "            continue\n",
    "\n",
    "        file_sales_count = 0\n",
    "\n",
    "        for row in all_trs:\n",
    "            tds = row.find_all(['td', 'th'])\n",
    "            cols = [td.get_text(strip=True) for td in tds]\n",
    "            \n",
    "            if not cols:\n",
    "                continue\n",
    "\n",
    "            # التحقق من أن الخلية الأولى تحتوي على رقم الإذن (رقم فقط)\n",
    "            clean_permit = cols[0].replace(\",\", \"\").strip()\n",
    "            if not clean_permit.isdigit():\n",
    "                continue\n",
    "\n",
    "            permit_no = int(clean_permit)\n",
    "\n",
    "            # البحث عن اسم الصنف (أول خلية تحتوي على حروف عربية أو إنجليزية)\n",
    "            item_idx = -1\n",
    "            for idx in range(1, len(cols)):\n",
    "                cleaned = cols[idx].strip()\n",
    "                if cleaned and re.search(r'[\\u0600-\\u06FFa-zA-Z]', cleaned):\n",
    "                    item_idx = idx\n",
    "                    break\n",
    "\n",
    "            if item_idx == -1:\n",
    "                continue  # سطر بدون اسم صنف\n",
    "\n",
    "            item_name = cols[item_idx].strip()\n",
    "\n",
    "            # استخراج الكود الصريح وتحويل اسمه إلى Barcode\n",
    "            # يتم أخذ آخر قيمة غير فارغة موجودة قبل اسم الصنف\n",
    "            codes_between = [cols[i].strip() for i in range(1, item_idx) if cols[i].strip()]\n",
    "            barcode_val = codes_between[-1] if codes_between else \"\"\n",
    "\n",
    "            # باقي العناصر الرقمية تتبع اسم الصنف مباشرة\n",
    "            # [السعر, الكمية, الخصم, الضرائب, الصافي, القيمة, ملاحظات, المقاس, اللون]\n",
    "            numeric_cols = [c.strip() for c in cols[item_idx + 1:] if c.strip() != \"\"]\n",
    "\n",
    "            price = safe_float(numeric_cols[0]) if len(numeric_cols) > 0 else 0.0\n",
    "            qty = safe_float(numeric_cols[1]) if len(numeric_cols) > 1 else 0.0\n",
    "            discount = safe_float(numeric_cols[2]) if len(numeric_cols) > 2 else 0.0\n",
    "            taxes = safe_float(numeric_cols[3]) if len(numeric_cols) > 3 else 0.0\n",
    "            net = safe_float(numeric_cols[4]) if len(numeric_cols) > 4 else 0.0\n",
    "            val = safe_float(numeric_cols[5]) if len(numeric_cols) > 5 else 0.0\n",
    "            \n",
    "            # استخراج المقاس واللون من أواخر الخلايا إن وجدا\n",
    "            size = numeric_cols[-2] if len(numeric_cols) >= 8 else \"--\"\n",
    "            color = numeric_cols[-1] if len(numeric_cols) >= 8 else \"--\"\n",
    "\n",
    "            all_extracted_rows.append({\n",
    "                \"Source_File\": file_name,\n",
    "                \"Permit_No\": permit_no,\n",
    "                \"Barcode\": barcode_val,\n",
    "                \"Item_Name\": item_name,\n",
    "                \"Price\": price,\n",
    "                \"Quantity\": qty,\n",
    "                \"Discount\": discount,\n",
    "                \"Taxes\": taxes,\n",
    "                \"Net\": net,\n",
    "                \"Value\": val,\n",
    "                \"Size\": size,\n",
    "                \"Color\": color,\n",
    "                \"Page_Num\": extract_page_number(file_name)\n",
    "            })\n",
    "            file_sales_count += 1\n",
    "\n",
    "        log(f\"📁 {file_name} -> تم استخراج {file_sales_count} صف مبيعات حقيقي.\")\n",
    "\n",
    "    df = pd.DataFrame(all_extracted_rows)\n",
    "    \n",
    "    if not df.empty:\n",
    "        df = df.sort_values(by=[\"Page_Num\", \"Permit_No\"]).drop(columns=[\"Page_Num\"])\n",
