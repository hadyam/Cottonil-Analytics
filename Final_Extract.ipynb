    "# Suppliers Acc"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6a574458-9c0c-46d5-af91-0629b7c34d6c",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import re\n",
    "import glob\n",
    "import pandas as pd\n",
    "from bs4 import BeautifulSoup\n",
    "\n",
    "# 1. تحديد المسارات المطلوبة\n",
    "INPUT_DIR = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\Html Cottonil Files\\كشف حساب الموردين\"\n",
    "OUTPUT_DIR = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\prepared data\\Suppliers\"\n",
    "OUTPUT_FILE = os.path.join(OUTPUT_DIR, \"Cottonil_Suppliers_Statement.csv\")\n",
    "\n",
    "# إنشاء مجلد الحفظ إذا لم يكن موجوداً\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "\n",
    "def parse_supplier_html(file_path):\n",
    "    \"\"\"\n",
    "    دالة لقرأة وتفكيك ملف HTML واستخراج بيانات كشف حساب المورد بدقة\n",
    "    \"\"\"\n",
    "    with open(file_path, 'r', encoding='windows-1256', errors='ignore') as f:\n",
    "        content = f.read()\n",
    "\n",
    "    soup = BeautifulSoup(content, 'html.parser')\n",
    "    tables = soup.find_all('table')\n",
    "\n",
    "    # استخراج اسم المورد من الجداول الأولى\n",
    "    supplier_name = \"\"\n",
    "    for t in tables[:4]:\n",
    "        text = t.get_text()\n",
    "        if \"كشف حساب\" in text:\n",
    "            tds = t.find_all('td')\n",
    "            # اسم المورد عادة يكون في الخلية الرابعة أو الثالثة\n",
    "            for td in tds:\n",
    "                val = td.get_text(strip=True)\n",
    "                if val and val not in [\"كشف حساب\", \"قطونيل شيراتون\", \"للفترة من\", \"إلى\", \"رصيد بدايه\"]:\n",
    "                    if not re.search(r'\\d', val): # يتأكد أنه اسم وليس تاريخ أو رقم\n",
    "                        supplier_name = val\n",
    "                        break\n",
    "            if supplier_name:\n",
    "                break\n",
    "\n",
    "    rows_data = []\n",
    "\n",
    "    # المرور على جداول المعاملات\n",
    "    for i, t in enumerate(tables):\n",
    "        tds = t.find_all('td')\n",
    "        texts = [td.get_text(strip=True) for td in tds]\n",
    "\n",
    "        # التحقق من أن الجدول يمثل صف معاملة مالية (يحتوي على تاريخ بصيغة DD/MM/YYYY)\n",
    "        if len(texts) >= 9 and any(re.search(r'\\d{2}/\\d{2}/\\d{4}', txt) for txt in texts):\n",
    "            # محاذاة الأعمدة بناءً على نمط الجداول\n",
    "            description = texts[1] if len(texts) > 1 else \"\"\n",
    "            date = next((txt for txt in texts if re.search(r'\\d{2}/\\d{2}/\\d{4}', txt)), \"\")\n",
    "            \n",
    "            # استخراج المبالغ المالية\n",
    "            invoices = texts[3] if len(texts) > 3 else \"0.00\"\n",
    "            returns = texts[4] if len(texts) > 4 else \"0.00\"\n",
    "            payments = texts[5] if len(texts) > 5 else \"0.00\"\n",
    "            discount = texts[6] if len(texts) > 6 else \"0.00\"\n",
    "            forwarded_balance = texts[7] if len(texts) > 7 else \"0.00\"\n",
    "            balance = texts[8] if len(texts) > 8 else \"0.00\"\n",
    "\n",
    "            # دمج نوع الرصيد المكسور على جدولين (مثل: \"دا\" + \"ئن\" = \"دائن\")\n",
    "            raw_balance_type = texts[9] if len(texts) > 9 else \"\"\n",
    "            if i + 1 < len(tables):\n",
    "                next_tds = tables[i+1].find_all('td')\n",
    "                next_texts = [td.get_text(strip=True) for td in next_tds]\n",
    "                if len(next_texts) >= 2 and next_texts[-1] in ['ئن', 'ين', 'دائن', 'مدين']:\n",
    "                    raw_balance_type += next_texts[-1]\n",
    "\n",
    "            # تنظيف نوع الرصيد\n",
    "            if any(k in raw_balance_type for k in ['دائن', 'دا', 'ئن']):\n",
    "                balance_type = 'دائن'\n",
    "            elif any(k in raw_balance_type for k in ['مدين', 'مد', 'ين']):\n",
    "                balance_type = 'مدين'\n",
    "            else:\n",
    "                balance_type = raw_balance_type\n",
    "\n",
    "            # --- تفكيك البيان إلى 3 أعمدة مشتقة ---\n",
    "            # 1. نوع العملية (استلام / ارتجاع / دفعة)\n",
    "            if \"إستلام\" in description or \"استلام\" in description:\n",
    "                doc_type = \"استلام\"\n",
    "            elif \"ارتجاع\" in description or \"إرتجاع\" in description:\n",
    "                doc_type = \"ارتجاع\"\n",
    "            elif \"دفعة\" in description:\n",
    "                doc_type = \"دفعة\"\n",
    "            else:\n",
    "                doc_type = description.split()[0] if description else \"أخرى\"\n",
    "\n",
    "            # 2. رقم الإذن / المعاملة\n",
    "            num_match = re.search(r'\\d+', description)\n",
    "            doc_number = num_match.group(0) if num_match else \"\"\n",
    "\n",
    "            # 3. طبيعة السداد (آجل / فوري)\n",
    "            payment_term = \"آجل\" if \"آجل\" in description else \"فوري\"\n",
    "\n",
    "            # تجميع الصف باللغات والأسماء المطلوبة بالإنجليزي\n",
    "            row_dict = {\n",
    "                'file_name': os.path.basename(file_path),\n",
    "                'supplier_name': supplier_name,\n",
    "                'description': description,\n",
    "                'doc_type': doc_type,\n",
    "                'doc_number': doc_number,\n",
    "                'payment_term': payment_term,\n",
    "                'date': date,\n",
    "                'invoices': invoices,\n",
    "                'returns': returns,\n",
    "                'payments': payments,\n",
    "                'discount': discount,\n",
    "                'forwarded_balance': forwarded_balance,\n",
    "                'balance': balance,\n",
    "                'balance_type': balance_type\n",
    "            }\n",
    "            rows_data.append(row_dict)\n",
    "\n",
    "    return rows_data\n",
    "\n",
    "def main():\n",
    "    # ترتيب الملفات طبيعياً بناءً على الرقم في اسمها (Natural Sorting)\n",
    "    def natural_sort_key(s):\n",
    "        return [int(text) if text.isdigit() else text.lower() for text in re.split(r'(\\d+)', s)]\n",
    "\n",
    "    html_files = sorted(glob.glob(os.path.join(INPUT_DIR, \"*.html\")), key=natural_sort_key)\n",
    "\n",
    "    if not html_files:\n",
    "        print(f\"❌ لم يتم العثور على أي ملفات HTML في المسار:\\n{INPUT_DIR}\")\n",
    "        return\n",
    "\n",
    "    all_data = []\n",
    "\n",
    "    # معالجة الملفات والطباعة بالشكل المطلوب\n",
    "    for file_path in html_files:\n",
    "        filename = os.path.basename(file_path)\n",
    "        extracted_rows = parse_supplier_html(file_path)\n",
    "        all_data.extend(extracted_rows)\n",
    "        print(f\"📁 {filename} -> تم استخراج {len(extracted_rows)} صف مبيعات حقيقي.\")\n",
    "\n",
    "    # تصدير الملف النهائي CSV\n",
    "    if all_data:\n",
    "        df = pd.DataFrame(all_data)\n",
    "        \n",
    "        # التأكد من ترتيب أسماء الأعمدة بالإنجليزي\n",
    "        columns_order = [\n",
    "            'file_name', 'supplier_name', 'description', \n",
    "            'doc_type', 'doc_number', 'payment_term', \n",
    "            'date', 'invoices', 'returns', 'payments', \n",
    "            'discount', 'forwarded_balance', 'balance', 'balance_type'\n",
    "        ]\n",
    "        df = df[columns_order]\n",
    "        \n",
    "        df.to_csv(OUTPUT_FILE, index=False, encoding='utf-8-sig')\n",
    "        print(f\"\\n✅ تم الحفظ بنجاح في:\\n📁 {OUTPUT_FILE}\")\n",
    "        print(f\"📊 إجمالي عدد الصفوف المستخرجة: {len(df)}\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  }
 ],
