   "source": [
    "import os\n",
    "import re\n",
    "import pandas as pd\n",
    "from bs4 import BeautifulSoup\n",
    "\n",
    "# ==========================================\n",
    "# Paths\n",
    "# ==========================================\n",
    "folder_path = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\Html Cottonil Files\\المشتريات\"\n",
    "output_file = r\"D:\\Hady Learning\\Data\\data analysis\\Mazen Course\\Real Data\\Cottonil\\prepared data\\Purchases\\Purchases_Cleaned.csv\"\n",
    "\n",
    "# ==========================================\n",
    "# Natural Sorting Function\n",
    "# ==========================================\n",
    "def extract_page_number(filename):\n",
    "    \"\"\"تستخرج رقم الصفحة من اسم الملف لضمان الترتيب الرقمي الصحيح\"\"\"\n",
    "    match = re.search(r\"Page(\\d+)\", filename, re.IGNORECASE)\n",
    "    if match:\n",
    "        return int(match.group(1))\n",
    "    return 1\n",
    "\n",
    "files = sorted(\n",
    "    [f for f in os.listdir(folder_path) if f.lower().endswith(\".html\")],\n",
    "    key=extract_page_number,\n",
    ")\n",
    "\n",
    "print(f\"Found {len(files)} HTML Files to process.\")\n",
    "\n",
    "# ==========================================\n",
    "# Global State Accumulators\n",
    "# ==========================================\n",
    "all_final_rows = []        # يحتوي على الصفوف النهائية للـ DataFrame\n",
    "current_doc_rows = []      # تجميع مؤقت لأصناف الإذن الحالي (عبر عدة صفحات)\n",
    "\n",
    "# متغيرات تتبع الهيدر والفوتر الحالي\n",
    "current_header = {\n",
    "    \"doc_no\": \"\",\n",
    "    \"doc_date\": \"\",\n",
    "    \"supplier\": \"\",\n",
    "    \"store\": \"المخزن الرئيسي\",\n",
    "    \"keeper\": \"أمين غير محدد\"\n",
    "}\n",
    "\n",
    "# ==========================================\n",
    "# Loop Files\n",
    "# ==========================================\n",
    "for file in files:\n",
    "    path = os.path.join(folder_path, file)\n",
    "\n",
    "    try:\n",
    "        with open(path, \"r\", encoding=\"windows-1256\", errors=\"ignore\") as f:\n",
    "            html_content = f.read()\n",
    "\n",
    "        soup = BeautifulSoup(html_content, \"html.parser\")\n",
    "        tables = soup.find_all(\"table\")\n",
    "        full_text = soup.get_text(\" \", strip=True)\n",
    "\n",
    "        # ----------------------------------\n",
    "        # 1. Header Extraction & State Reset\n",
    "        # ----------------------------------\n",
    "        has_new_header = \"رقم إذن\" in full_text or \"المورد\" in full_text\n",
    "\n",
    "        if has_new_header:\n",
    "            # تفريغ وترحيل الإذن السابق\n",
    "            if current_doc_rows:\n",
    "                all_final_rows.extend(current_doc_rows)\n",
    "                current_doc_rows = []\n",
    "\n",
    "            # إعادة إعادة تعيين قيم الهيدر الافتراضية للإذن الجديد\n",
    "            current_header = {\n",
    "                \"doc_no\": \"\",\n",
    "                \"doc_date\": \"\",\n",
    "                \"supplier\": \"\",\n",
    "                \"store\": \"المخزن الرئيسي\",\n",
    "                \"keeper\": \"أمين غير محدد\"\n",
    "            }\n",
    "\n",
    "            for tbl in tables[:4]:\n",
    "                text = tbl.get_text(\" \", strip=True)\n",
    "\n",
    "                if \"رقم إذن\" in text or \"إذن\" in text:\n",
    "                    no_match = re.search(r\"رقم\\s*إذن\\s*(\\d+)\", text)\n",
    "                    if not no_match:\n",
    "                        no_match = re.search(r\"\\d+\", text)\n",
    "                    if no_match:\n",
    "                        current_header[\"doc_no\"] = f\"رقم إذن {no_match.group(1) if len(no_match.groups()) > 0 else no_match.group(0)}\"\n",
    "\n",
    "                if \"202\" in text or \"التاريخ\" in text:\n",
    "                    date_match = re.search(r\"\\d{4}/\\d{1,2}/\\d{1,2}\", text)\n",
    "                    if date_match:\n",
    "                        current_header[\"doc_date\"] = date_match.group(0)\n",
    "\n",
    "                if \"المورد\" in text:\n",
    "                    sup_match = re.search(r\"المورد\\s*:\\s*([\\u0600-\\u06FF]+)\", text)\n",
    "                    if sup_match:\n",
    "                        current_header[\"supplier\"] = sup_match.group(1)\n",
    "\n",
    "        # ----------------------------------\n",
    "        # 2. Footer Extraction (قبل استخراج الأصناف لضمان صحة القيم)\n",
    "        # ----------------------------------\n",
    "        has_footer = \"أمين\" in full_text or \"المخــزن\" in full_text or \"المخزن\" in full_text\n",
    "\n",
    "        if has_footer:\n",
    "            for tbl in tables:\n",
    "                # إستخراج جميع الخلايا النصية غير الفارغة\n",
    "                tds = [td.get_text(strip=True) for td in tbl.find_all(\"td\") if td.get_text(strip=True)]\n",
    "\n",
    "                for i, val in enumerate(tds):\n",
    "                    # استخراج أمين المخزن من الخلية المجاورة لـ \"أمين\" أو \"أمين المخزن\"\n",
    "                    if (\"أمين\" in val) and i + 1 < len(tds):\n",
    "                        next_val = tds[i + 1].replace(\":\", \"\").strip()\n",
    "                        # التاكد من أن الخلية التالية اسم شخص وليست كلمة هيكلية\n",
    "                        if next_val and next_val not in [\"المخزن\", \"المخــزن\", \"غير محدد\", \"أمين\"] and not next_val.startswith(\"المخزن\"):\n",
    "                            current_header[\"keeper\"] = next_val if next_val.startswith(\"أمين\") else f\"أمين {next_val}\"\n",
    "\n",
    "                    # استخراج اسم المخزن من الخلية المجاورة لـ \"المخزن\"\n",
    "                    if (\"المخزن\" in val or \"المخــزن\" in val) and i + 1 < len(tds):\n",
    "                        next_val = tds[i + 1].replace(\":\", \"\").strip()\n",
    "                        # استبعاد أن تكون الخلية التالية كلمة أمين أو اسم شخص\n",
    "                        if next_val and next_val not in [\"أمين\", \"غير محدد\"] and not next_val.startswith(\"أمين\"):\n",
    "                            current_header[\"store\"] = next_val if \"مخزن\" in next_val else f\"المخزن {next_val}\"\n",
    "\n",
    "        # ----------------------------------\n",
    "        # 3. Items Data Extraction\n",
    "        # ----------------------------------\n",
    "        for tbl in tables:\n",
    "            rows_in_tbl = tbl.find_all(\"tr\")\n",
    "\n",
    "            for tr in rows_in_tbl:\n",
    "                tds = tr.find_all(\"td\")\n",
    "                \n",
    "                if len(tds) < 8:\n",
    "                    continue\n",
    "\n",
    "                raw_values = [td.get_text(strip=True) for td in tds]\n",
    "                \n",
    "                if any(h in raw_values for h in [\"الباركود\", \"الكود\", \"الصنف\", \"الإجمالى\", \"الشراء\", \"اوكازيون\"]):\n",
    "                    continue\n",
    "\n",
    "                first_val = raw_values[0] if raw_values[0] != \"\" else (raw_values[1] if len(raw_values) > 1 else \"\")\n",
    "                \n",
    "                if not (first_val.isdigit() and 3 <= len(first_val) <= 4):\n",
    "                    continue\n",
    "\n",
    "                barcode = first_val\n",
    "                start_idx = 0 if raw_values[0] != \"\" else 1\n",
    "                \n",
    "                item_name = raw_values[start_idx + 2] if len(raw_values) > start_idx + 2 else \"\"\n",
    "                category  = raw_values[start_idx + 3] if len(raw_values) > start_idx + 3 else \"\"\n",
    "                size      = raw_values[start_idx + 4] if len(raw_values) > start_idx + 4 else \"\"\n",
    "                color     = raw_values[start_idx + 5] if len(raw_values) > start_idx + 5 else \"\"\n",
    "                \n",
    "                if re.match(r\"^\\d+(\\.\\d+)?$\", color):\n",
    "                    color = \"--\"\n",
    "\n",
    "                price_buy    = raw_values[start_idx + 6] if len(raw_values) > start_idx + 6 else \"\"\n",
    "                price_retail = raw_values[start_idx + 7] if len(raw_values) > start_idx + 7 else \"\"\n",
    "                discount     = raw_values[start_idx + 8] if len(raw_values) > start_idx + 8 else \"0.00\"\n",
    "                qty          = raw_values[start_idx + 9] if len(raw_values) > start_idx + 9 else \"\"\n",
    "\n",
    "                if item_name and barcode:\n",
    "                    current_doc_rows.append(\n",
    "                        {\n",
    "                            \"Source_File\": file,\n",
    "                            \"Date\": current_header[\"doc_date\"],\n",
    "                            \"Doc_No\": current_header[\"doc_no\"],\n",
    "                            \"Supplier\": current_header[\"supplier\"],\n",
    "                            \"Barcode\": barcode,\n",
    "                            \"Item_Name\": item_name,\n",
    "                            \"Category\": category,\n",
    "                            \"Size\": size,\n",
    "                            \"Color\": color,\n",
    "                            \"Buy_Price\": price_buy,\n",
    "                            \"Retail_Price\": price_retail,\n",
    "                            \"Discount\": discount,\n",
    "                            \"Quantity\": qty,\n",
    "                            \"Store\": current_header[\"store\"],\n",
    "                            \"Keeper\": current_header[\"keeper\"]\n",
    "                        }\n",
    "                    )\n",
    "\n",
    "        # تحديث قيم الأصناف التي استُخرجت في هذه الصفحة بآخر حالة للهيدر والفوتر\n",
    "        for r in current_doc_rows:\n",
    "            r[\"Keeper\"] = current_header[\"keeper\"]\n",
    "            r[\"Store\"]  = current_header[\"store\"]\n",
    "\n",
    "        print(f\"✔ Processed: {file}\")\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error processing {file}: {e}\")\n",
    "\n",
    "# إضافة باقي الصفوف للإذن الأخير\n",
    "if current_doc_rows:\n",
    "    all_final_rows.extend(current_doc_rows)\n",
    "\n",
    "# ==========================================\n",
    "# Export DataFrame & Remove Duplicates\n",
    "# ==========================================\n",
    "columns = [\n",
    "    \"Source_File\",\n",
    "    \"Date\",\n",
    "    \"Doc_No\",\n",
    "    \"Supplier\",\n",
    "    \"Barcode\",\n",
    "    \"Item_Name\",\n",
    "    \"Category\",\n",
    "    \"Size\",\n",
    "    \"Color\",\n",
    "    \"Buy_Price\",\n",
    "    \"Retail_Price\",\n",
    "    \"Discount\",\n",
    "    \"Quantity\",\n",
    "    \"Store\",\n",
    "    \"Keeper\",\n",
    "]\n",
    "\n",
    "df = pd.DataFrame(all_final_rows, columns=columns)\n",
    "df.drop_duplicates(inplace=True)\n",
    "\n",
    "os.makedirs(os.path.dirname(output_file), exist_ok=True)\n",
    "df.to_csv(output_file, index=False, encoding=\"utf-8-sig\")\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(f\"Done! Successfully extracted {len(df)} records.\")"
   ]
  },
